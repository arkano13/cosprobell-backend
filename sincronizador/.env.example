# Service Layer dentro de la red de Cosprobell (termina en /b1s/v1 o /b1s/v2).
SAP_SL_URL=https://servidor-sap:50000/b1s/v1
SAP_COMPANY_DB=NOMBRE_DE_LA_EMPRESA
SAP_USER=usuario_integracion_lectura
SAP_PASSWORD=

# Backend que recibe los lotes. Debe usar HTTPS salvo en pruebas locales.
BACKEND_URL=https://tu-backend.up.railway.app

# Mismo valor que BRIDGE_SECRET en el backend (mínimo 32 caracteres).
BRIDGE_SECRET=

# Si Service Layer usa un certificado autofirmado, exporta el certificado
# y define antes de ejecutar:
#   NODE_EXTRA_CA_CERTS=C:\cosprobell\service-layer.pem
# Nunca uses NODE_TLS_REJECT_UNAUTHORIZED=0.
