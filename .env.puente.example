# Copiar a .env.puente SOLO en el equipo del puente. No contiene credenciales reales.
SAP_SERVICE_LAYER_URL=https://SERVIDOR.COSPROBELL.COM:50000/b1s/v1
SAP_COMPANY_DB=XPRUEBAS2026
SAP_USER=USUARIO_DE_INTEGRACION
SAP_PASSWORD=REEMPLAZAR
BACKEND_URL=https://DOMINIO_DEL_BACKEND
BRIDGE_API_KEY=REEMPLAZAR_POR_LA_CLAVE_CONFIGURADA_EN_EL_BACKEND
BRIDGE_STATE_DIR=.bridge-state
BRIDGE_INTERVAL_SECONDS=900
# Segundos entre recorridos completos por entidad. Elegir despues de medir.
# Vacio: primera carga y continuaciones solamente; luego requiere --forzar.
BRIDGE_FREQUENCIES_JSON={}
# Activar despues de actualizar el backend y aplicar su migracion de recorridos.
BRIDGE_INVENTORY_ENABLED=false
# sql-01-02 requiere registrar y comprobar la consulta de lectura antes de sincronizar.
# sql-almacenes permite elegir de 1 a 10 codigos exactos. Registrar/comprobar al cambiar la lista.
BRIDGE_STOCK_MODE=items
# Solo con sql-almacenes, descomentar y confirmar mayusculas/minusculas contra SAP:
# BRIDGE_WAREHOUSES=01,02,v01,v03,v05,v05-1,99
# Al activar inventario, agregar a las frecuencias elegidas: "almacenes":3600,"existencias":900
# Presupuesto por ejecucion; el avance se retoma en la siguiente.
BRIDGE_MAX_REQUESTS=25
BRIDGE_MAX_SECONDS=120
BRIDGE_REQUEST_DELAY_MS=500
# Certificado del Service Layer: NODE_EXTRA_CA_CERTS NO funciona dentro de este archivo (Node lo lee antes).
# En Windows, guardar el PEM como certificado\service-layer.pem junto a ejecutar-puente.cmd; el script lo aplica.
# Alternativa explicita, incluida produccion: confiar solo en la huella del certificado.
# Omite vencimiento, nombre y CA. Obtener la huella por un canal independiente.
SAP_TLS_PINNED_CERTIFICATE=false
SAP_TLS_CERT_SHA256=

# Segunda etapa: ejecutar-finanzas.js. No se activa con ejecutar-puente.cmd.
# Mantener desactivada hasta desplegar el backend, migrar y comprobar las consultas.
BRIDGE_FINANCE_ENABLED=false
# Todo el historial disponible de SAP desde 1900. Abiertos: sin límite histórico.
BRIDGE_FINANCE_SINCE=1900-01-01
# Códigos exactos de moneda local y de sistema en SAP (OADM).
BRIDGE_FINANCE_LOCAL_CURRENCY=
BRIDGE_FINANCE_SYSTEM_CURRENCY=
# U_ZONA confirmado como ruta. Zona independiente todavía no confirmada.
BRIDGE_FINANCE_ZONE_FIELD=
BRIDGE_FINANCE_ROUTE_FIELD=U_ZONA
# Vacío: primera carga y continuaciones. Después requiere --forzar.
BRIDGE_FINANCE_FREQUENCIES_JSON={}
BRIDGE_FINANCE_MAX_REQUESTS=10
BRIDGE_FINANCE_MAX_SECONDS=60
