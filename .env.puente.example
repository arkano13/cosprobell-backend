# Copiar a .env.puente SOLO en el equipo del puente. No contiene credenciales reales.
SAP_SERVICE_LAYER_URL=https://SERVIDOR.COSPROBELL.COM:50000/b1s/v1
SAP_COMPANY_DB=XPRUEBAS2026
SAP_USER=USUARIO_DE_INTEGRACION
SAP_PASSWORD=REEMPLAZAR
BACKEND_URL=https://DOMINIO_DEL_BACKEND
BRIDGE_API_KEY=REEMPLAZAR_POR_LA_CLAVE_CONFIGURADA_EN_EL_BACKEND
BRIDGE_STATE_DIR=.bridge-state
BRIDGE_INTERVAL_SECONDS=900
# Si SAP usa una CA privada, indicar su certificado PEM antes de arrancar Node:
# NODE_EXTRA_CA_CERTS=C:/ruta/certificado-ca.pem
